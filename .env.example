# Copy to .env.local (never committed). Every variable is validated by src/shared/config/env.ts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: Calendly page (https://calendly.com/<user>/<event>). Empty hides the "Book a call" tab.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/gonzalezlovullocarlos/30-minutes-google-meet
# Sub-path the site is served from: empty locally, /portfolio for the GitHub Pages project page.
NEXT_PUBLIC_BASE_PATH=
# Sanity content (ADR-003), read at build time. Not secrets: the dataset is public, no token.
SANITY_PROJECT_ID=8i6zw2b7
SANITY_DATASET=production
# Pinned API version (a date, never "latest").
SANITY_API_VERSION=2026-10-01
