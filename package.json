{
  "name": "my-portfolio",
  "version": "0.1.0",
  "description": "I created this portfolio to showcase my projects, share my ongoing tech watch, and highlight my skill set. Download my CV directly from the site or use the contact section to drop a message—I’d love to connect!",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "bundle:check": "tsx scripts/check-client-bundle.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "biome check . && eslint .",
    "lint:fix": "biome check --write . && eslint . --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "coverage": "vitest run --project unit --coverage",
    "test:storybook": "vitest run --project storybook",
    "test:e2e": "playwright test",
    "lighthouse": "tsx scripts/lighthouse-site.ts && lhci autorun",
    "knip": "knip",
    "secrets": "sh scripts/secrets.sh",
    "prepare": "husky",
    "lint:arch": "steiger ./src --fail-on-warnings && depcruise . --config .dependency-cruiser.cjs",
    "lint:language": "node scripts/check-inclusive-language.mjs",
    "content:check": "tsx --env-file-if-exists=.env.local scripts/content-check.ts",
    "icon:render": "tsx scripts/render-apple-icon.tsx",
    "typegen": "pnpm --filter portfolio-studio typegen",
    "studio:dev": "pnpm --filter portfolio-studio dev",
    "studio:deploy": "pnpm --filter portfolio-studio run deploy",
    "studio:seed": "pnpm --filter portfolio-studio seed",
    "deploy": "gh workflow run deploy.yml --ref main",
    "check:agent": "node scripts/check-agent.mjs",
    "worktrees:prune": "node scripts/prune-worktrees.mjs",
    "audit:deps": "node scripts/audit-deps.mjs",
    "sast": "sh scripts/tool.sh semgrep semgrep/semgrep:1.181.0 scan --metrics=off --error --quiet --config p/typescript --config p/react --config p/nextjs",
    "lint:dup": "jscpd .",
    "size": "size-limit"
  },
  "dependencies": {
    "@sanity/client": "^8.9.0",
    "@sanity/image-url": "^2.1.1",
    "goniui": "^0.1.0",
    "groq": "^6.19.0",
    "lucide-react": "^1.56.0",
    "motion": "^14.2.0",
    "next": "^16.3.8",
    "portfolio-content-model": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "tailwind-variants": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@size-limit/file": "^14.2.0",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/nextjs-vite": "^10.6.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-config-biome": "^2.1.3",
    "eslint-config-next": "^16.4.2",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "husky": "^9.1.7",
    "jscpd": "^5.4.2",
    "jsdom": "^30.1.3",
    "knip": "^6.42.1",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.31",
    "serve": "^14.2.6",
    "size-limit": "^14.2.0",
    "steiger": "^0.8.0",
    "storybook": "^10.6.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,tsx,jsx}": [
      "biome check --write --no-errors-on-unmatched",
      "eslint --fix"
    ],
    "*.{json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
