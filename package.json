{
  "name": "my-portfolio",
  "version": "0.1.0",
  "description": "I created this portfolio to showcase my projects, share my ongoing tech watch, and highlight my skill set. Download my CV directly from the site or use the contact section to drop a message—I’d love to connect!",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "bundle:check": "tsx scripts/check-client-bundle.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "coverage": "vitest run --project unit --coverage",
    "test:storybook": "vitest run --project storybook",
    "test:e2e": "playwright test",
    "lighthouse": "tsx scripts/lighthouse-site.ts && lhci autorun",
    "knip": "knip",
    "secrets": "secretlint \"**/*\"",
    "prepare": "husky",
    "lint:arch": "steiger ./src --fail-on-warnings && depcruise . --config .dependency-cruiser.cjs",
    "lint:language": "node scripts/check-inclusive-language.mjs",
    "content:check": "tsx --env-file-if-exists=.env.local scripts/content-check.ts",
    "icon:render": "tsx scripts/render-apple-icon.tsx",
    "typegen": "pnpm --filter portfolio-studio typegen",
    "studio:dev": "pnpm --filter portfolio-studio dev",
    "studio:deploy": "pnpm --filter portfolio-studio deploy",
    "studio:seed": "pnpm --filter portfolio-studio seed"
  },
  "dependencies": {
    "@sanity/client": "^8.9.0",
    "@sanity/image-url": "^2.1.1",
    "goniui": "^0.1.0",
    "groq": "^6.19.0",
    "lucide-react": "^1.56.0",
    "next": "^16.3.8",
    "portfolio-content-model": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "tailwind-variants": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/nextjs-vite": "^10.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser": "^5.0.4",
    "@vitest/browser-playwright": "^5.0.4",
    "@vitest/coverage-v8": "^5.0.3",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "knip": "^6.39.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "secretlint": "^13.0.7",
    "serve": "^14.2.6",
    "steiger": "^0.7.0",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "lint-staged": {
    "*": [
      "secretlint"
    ],
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss,yml,yaml,html}": [
      "prettier --write"
    ]
  }
}
